# Copy to ~/.config/agent-planner/web.env (read by systemd/agent-planner-web.service)
# or export the variables before `bun src/web/server.ts`.
# systemd EnvironmentFile: plain KEY=value lines, no %h or ~ expansion.

# Folder with the agent files (<slug>.md). Required.
AGENT_PLANNER_DIR=/home/USER/agents

# Default working directory pre-filled in the "new agent" form. Optional.
AGENT_PLANNER_DEFAULT_CWD=/home/USER/projects

# Reachable from this machine only (default). To serve the LAN, uncomment all three lines
# and read the "Network exposure" section of the README first: there is no login.
#AGENT_PLANNER_HOST=0.0.0.0
#AGENT_PLANNER_ALLOWED_CLIENTS=192.0.2.0/24
#AGENT_PLANNER_ALLOWED_HOSTS=192.0.2.10:4317

# Credentials for the Agent SDK. Not read from this file by the runner: scheduled runs get them from
# the systemd user manager (`systemctl --user import-environment ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN`).
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
